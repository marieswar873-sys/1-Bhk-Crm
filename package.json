{
  "name": "1bhk-crm",
  "version": "1.0.7",
  "description": "1BHK Kitchen CRM - Restaurant Billing System",
  "main": "electron.js",
  "scripts": {
    "server": "node server/index.js",
    "client": "cd client && npx react-scripts start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npx react-scripts build",
    "electron": "electron .",
    "electron-dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win"
  },
  "keywords": [],
  "author": "1BHK Kitchen",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.5.0",
    "nodemailer": "^9.0.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.1"
  },
  "build": {
    "appId": "com.1bhk.crm",
    "productName": "1BHK CRM",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron.js",
      "preload.js",
      "server/**/*",
      "client/build/**/*",
      "node_modules/**/*",
      ".env"
    ],
    "win": {
      "target": "nsis",
      "icon": "app-icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "1BHK-CRM-Setup.${ext}",
      "installerIcon": "app-icon.ico",
      "uninstallerIcon": "app-icon.ico",
      "shortcutName": "1BHK CRM",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
